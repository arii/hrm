// File: app/client/control/page.tsx (Workout Control Panel - Phone UI)
/**
 * Workout Control Panel (Phone UI): Allows the user to control the Tabata Timer
 * and send Spotify playback commands. Simulates a mobile interface.
 */
"use client";
import {
  Add, // New import for stepper
  MusicNote,
  PlayArrow,
  Remove, // New import for stepper
  SkipNext,
  SkipPrevious,
  Stop, // New import for stop button
  VolumeUp,
} from "@mui/icons-material";
import {
  Box,
  Button,
  ButtonGroup,
  Card,
  CardContent,
  Container,
  FormControl,
  IconButton,
  InputLabel,
  MenuItem,
  Select,
  Slider,
  Stack,
  TextField,
  Typography,
} from "@mui/material";
import { Session } from "next-auth";
import { signIn, signOut, useSession } from "next-auth/react";
import { useCallback, useEffect, useRef, useState } from "react";
import { useAudioPlayer } from "../../../hooks/useAudioPlayer";
import useSpotifyWebPlayback from "../../../hooks/useSpotifyWebPlayback";
import useWebSocket from "../../../hooks/useWebSocket";
import {
  SpotifyCommandMessage,
  TimerCommandMessage,
} from "../../../types/websocket";

// Define SpotifyDevice interface for client-side use
interface SpotifyDevice {
  id: string;
  is_active: boolean;
  is_private_session: boolean;
  is_restricted: boolean;
  name: string;
  type: string;
  volume_percent: number;
}

const ControlPanel = () => {
  const { timerData, spotifyData, connectionStatus, sendData } = useWebSocket();
  const { initAudio, playSound } = useAudioPlayer();
  const { data: session }: { data: Session | null | undefined } = useSession();
  const {
    player: _player,
    isReady,
    deviceId,
    error: webPlaybackError,
  } = useSpotifyWebPlayback();

  // Timer configuration state
  const [workTime, setWorkTime] = useState(20);
  const [restTime, setRestTime] = useState(10);
  const [volume, setVolume] = useState(50);
  const [isRunningClockMode, setIsRunningClockMode] = useState(false);

  // Input validation states
  const [isValidWorkTime, setIsValidWorkTime] = useState(true);
  const [isValidRestTime, setIsValidRestTime] = useState(true);

  const workTimeInputRef = useRef<HTMLInputElement>(null);
  const restTimeInputRef = useRef<HTMLInputElement>(null);

  // Spotify device management states
  const [availableDevices, setAvailableDevices] = useState<SpotifyDevice[]>([]);
  const [selectedDeviceId, setSelectedDeviceId] = useState<string>("");
  const [devicesLoading, setDevicesLoading] = useState(false);
  const [devicesError, setDevicesError] = useState<string | null>(null);

  // --- Timer Commands ---
  const _sendTimerCommand = useCallback(
    (command: "START" | "STOP") => {
      // Only send command if inputs are valid
      if (!isValidWorkTime || !isValidRestTime) {
        console.warn("Cannot start timer with invalid work/rest durations.");
        return;
      }

      if (command === "START") {
        initAudio(); // Initialize audio on user interaction
        // Send config with START command
        const message: TimerCommandMessage = {
          type: "TIMER_COMMAND",
          command,
          workDuration: workTime,
          restDuration: restTime,
          isCountingUp: isRunningClockMode,
        };
        sendData(message);
      } else if (command === "STOP") {
        const message: TimerCommandMessage = { type: "TIMER_COMMAND", command };
        sendData(message);
      }
    },
    [isValidWorkTime, isValidRestTime, initAudio, workTime, restTime, sendData, isRunningClockMode]
  );

  // --- Spotify Commands ---
  const sendSpotifyCommand = (
    command: "PLAY" | "NEXT" | "PREVIOUS" | "TRANSFER_PLAYBACK",
    deviceId?: string
  ) => {
    const message: SpotifyCommandMessage = {
      type: "SPOTIFY_COMMAND",
      command,
      deviceId,
    };
    sendData(message); // sendData now accepts the typed object
  };

  const handleSpotifyLogin = () => {
    // Trigger the NextAuth login flow
    signIn("spotify", { callbackUrl: "/client/control" });
  };

  const handleSpotifyLogout = async () => {
    try {
      // 1. Clear the server-side token file
      await fetch("/api/internal/clear-token", { method: "POST" });

      // 2. Sign out from NextAuth (clears session cookies)
      await signOut({ callbackUrl: "/client/control" });
    } catch (error) {
      console.error("Error during logout:", error);
    }
  };

  // Use NextAuth session to check login status (not WebSocket data)
  const spotifyLoggedIn = !!session?.user;

  // Fetch available Spotify devices
  useEffect(() => {
    if (spotifyLoggedIn) {
      const fetchDevices = async () => {
        setDevicesLoading(true);
        setDevicesError(null);
        try {
          const response = await fetch("/api/spotify/devices");
          if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
          }
          const devices: SpotifyDevice[] = await response.json();
          setAvailableDevices(devices);
          // Automatically select the active device if one exists
          const activeDevice = devices.find((d) => d.is_active);
          if (activeDevice) {
            setSelectedDeviceId(activeDevice.id);
          } else if (devices.length > 0) {
            // Otherwise, select the first available device
            setSelectedDeviceId(devices[0].id);
          }
        } catch (error: unknown) {
          console.error("Failed to fetch Spotify devices:", error);
          setDevicesError(
            error instanceof Error
              ? error.message
              : String(error) || "Failed to load devices."
          );
        } finally {
          setDevicesLoading(false);
        }
      };
      fetchDevices();
    } else {
      setAvailableDevices([]);
      setSelectedDeviceId("");
    }
  }, [spotifyLoggedIn]);

  // Timer preset configurations
  const _applyPreset = (
    preset: "EMOM_20_10" | "EMOM_30_15" | "RUNNING_CLOCK"
  ) => {
    if (preset === "EMOM_20_10") {
      setWorkTime(20);
      setRestTime(10);
      setIsRunningClockMode(false);
    } else if (preset === "EMOM_30_15") {
      setWorkTime(30);
      setRestTime(15);
      setIsRunningClockMode(false);
    } else if (preset === "RUNNING_CLOCK") {
      // Running clock - continuous work, no rest
      setWorkTime(60);
      setRestTime(0);
      setIsRunningClockMode(true);
    }
  };

  // Handle incoming sound commands from the server
  useEffect(() => {
    if (timerData.soundToPlay) {
      playSound(timerData.soundToPlay);
    }
  }, [timerData.soundToPlay, playSound]);

  // Add haptic feedback on phase changes
  useEffect(() => {
    if (timerData.currentPhase && "vibrate" in navigator) {
      // Vibrate for a short duration (e.g., 100ms) on phase change
      navigator.vibrate(100);
    }
  }, [timerData.currentPhase]);

  // Add keyboard shortcuts
  useEffect(() => {
    const handleKeyPress = (e: KeyboardEvent) => {
      if (e.code === "Space" && !e.repeat) {
        e.preventDefault();
        if (timerData.currentPhase === "IDLE") {
          _sendTimerCommand("START");
        }
      }
      if (e.code === "KeyS" && e.ctrlKey) {
        e.preventDefault();
        _sendTimerCommand("STOP");
      }
    };

    window.addEventListener("keydown", handleKeyPress);
    return () => window.removeEventListener("keydown", handleKeyPress);
  }, [timerData.currentPhase, _sendTimerCommand]);

  return (
    <Container
      maxWidth="xs"
      sx={{
        py: { xs: 2, sm: 3 },
        px: { xs: 2, sm: 3 },
        minHeight: "100vh",
        backgroundColor: "background.default",
      }}
    >
      {/* 1. Tabata Timer Display & Controls */}
      <Card
        sx={{
          mb: 3,
          backgroundColor: "#000000",
          color: "#EF4444",
          position: "sticky",
          top: 16,
          zIndex: 1000,
          boxShadow: 6,
        }}
      >
        <CardContent sx={{ p: { xs: 2, sm: 3 } }}>
          {/* Timer Display */}
          <Box
            sx={{ textAlign: "center", mb: 3 }}
            role="timer"
            aria-live="polite"
          >
            <Typography
              variant="h2"
              component="div"
              sx={{
                fontFamily: "monospace",
                fontWeight: 700,
                color: "#EF4444",
                fontSize: { xs: "4rem", sm: "5rem" },
                textShadow: "0 0 20px rgba(239, 68, 68, 0.5)",
              }}
            >
              {timerData.timeRemaining}
            </Typography>
            <Typography variant="body1" sx={{ color: "white", mt: 1 }}>
              {timerData.currentPhase || "IDLE"} • Cycle {timerData.cycle}
              {timerData.isCountingUp ? "" : `/${timerData.totalCycles}`}
            </Typography>
          </Box>

          {/* Primary Control Buttons */}
          <Stack direction="row" spacing={2} sx={{ mb: 3 }}>
            <Button
              variant="contained"
              color="success"
              onClick={() => _sendTimerCommand("START")}
              disabled={connectionStatus !== "Connected"}
              fullWidth
              size="large"
              sx={{
                minHeight: 56,
                fontSize: "1.125rem",
                fontWeight: 600,
              }}
              startIcon={<PlayArrow />}
              aria-label="Start timer"
            >
              START
            </Button>
            <Button
              variant="contained"
              color="error"
              onClick={() => _sendTimerCommand("STOP")}
              disabled={connectionStatus !== "Connected"}
              fullWidth
              size="large"
              sx={{
                minHeight: 56,
                fontSize: "1.125rem",
                fontWeight: 600,
              }}
              startIcon={<Stop />}
              aria-label="Stop timer"
            >
              STOP
            </Button>
          </Stack>

          {/* Timer Configuration - Collapsible */}
          <Box sx={{ borderTop: "1px solid rgba(255,255,255,0.1)", pt: 3 }}>
            <Typography
              variant="overline"
              sx={{ color: "rgba(255,255,255,0.7)", display: "block", mb: 2 }}
            >
              Configuration
            </Typography>
            
            <Stack spacing={3}>
              {/* Work Duration Stepper */}
              <Box>
                <Typography
                  variant="caption"
                  sx={{ color: "rgba(255,255,255,0.7)", display: "block", mb: 1 }}
                >
                  Work Duration (seconds)
                </Typography>
                <Stack direction="row" alignItems="center" spacing={2}>
                  <IconButton
                    onClick={() => setWorkTime((prev) => Math.max(5, prev - 5))}
                    aria-label="Decrease work duration"
                    sx={{
                      backgroundColor: "rgba(255,255,255,0.1)",
                      color: "white",
                      minWidth: 48,
                      minHeight: 48,
                      "&:hover": { backgroundColor: "rgba(255,255,255,0.2)" },
                    }}
                  >
                    <Remove />
                  </IconButton>
                  <TextField
                    type="number"
                    value={workTime}
                    onChange={(e) => {
                      const value = parseInt(e.target.value, 10);
                      if (!isNaN(value) && value >= 0) {
                        setWorkTime(value);
                        setIsValidWorkTime(true);
                      } else {
                        setIsValidWorkTime(false);
                      }
                    }}
                    error={!isValidWorkTime}
                    inputProps={{ min: 0, style: { textAlign: "center" } }}
                    sx={{
                      flex: 1,
                      "& .MuiInputBase-input": { 
                        color: "#EF4444", 
                        fontSize: "1.5rem",
                        fontWeight: 600,
                      },
                      "& .MuiOutlinedInput-notchedOutline": {
                        borderColor: "rgba(255,255,255,0.2)",
                      },
                    }}
                    aria-label="Work duration in seconds"
                  />
                  <IconButton
                    onClick={() => setWorkTime((prev) => prev + 5)}
                    aria-label="Increase work duration"
                    sx={{
                      backgroundColor: "rgba(255,255,255,0.1)",
                      color: "white",
                      minWidth: 48,
                      minHeight: 48,
                      "&:hover": { backgroundColor: "rgba(255,255,255,0.2)" },
                    }}
                  >
                    <Add />
                  </IconButton>
                </Stack>
              </Box>

              {/* Rest Duration Stepper */}
              <Box>
                <Typography
                  variant="caption"
                  sx={{ color: "rgba(255,255,255,0.7)", display: "block", mb: 1 }}
                >
                  Rest Duration (seconds)
                </Typography>
                <Stack direction="row" alignItems="center" spacing={2}>
                  <IconButton
                    onClick={() => setRestTime((prev) => Math.max(0, prev - 5))}
                    aria-label="Decrease rest duration"
                    sx={{
                      backgroundColor: "rgba(255,255,255,0.1)",
                      color: "white",
                      minWidth: 48,
                      minHeight: 48,
                      "&:hover": { backgroundColor: "rgba(255,255,255,0.2)" },
                    }}
                  >
                    <Remove />
                  </IconButton>
                  <TextField
                    type="number"
                    value={restTime}
                    onChange={(e) => {
                      const value = parseInt(e.target.value, 10);
                      if (!isNaN(value) && value >= 0) {
                        setRestTime(value);
                        setIsValidRestTime(true);
                      } else {
                        setIsValidRestTime(false);
                      }
                    }}
                    error={!isValidRestTime}
                    inputProps={{ min: 0, style: { textAlign: "center" } }}
                    sx={{
                      flex: 1,
                      "& .MuiInputBase-input": { 
                        color: "#EF4444", 
                        fontSize: "1.5rem",
                        fontWeight: 600,
                      },
                      "& .MuiOutlinedInput-notchedOutline": {
                        borderColor: "rgba(255,255,255,0.2)",
                      },
                    }}
                    aria-label="Rest duration in seconds"
                  />
                  <IconButton
                    onClick={() => setRestTime((prev) => prev + 5)}
                    aria-label="Increase rest duration"
                    sx={{
                      backgroundColor: "rgba(255,255,255,0.1)",
                      color: "white",
                      minWidth: 48,
                      minHeight: 48,
                      "&:hover": { backgroundColor: "rgba(255,255,255,0.2)" },
                    }}
                  >
                    <Add />
                  </IconButton>
                </Stack>
              </Box>

              {/* Timer Presets */}
              <ButtonGroup fullWidth variant="outlined" size="small">
                <Button
                  onClick={() => _applyPreset("EMOM_20_10")}
                  sx={{
                    color: "rgba(255,255,255,0.8)",
                    borderColor: "rgba(255,255,255,0.2)",
                    fontSize: "0.75rem",
                  }}
                >
                  20/10
                </Button>
                <Button
                  onClick={() => _applyPreset("EMOM_30_15")}
                  sx={{
                    color: "rgba(255,255,255,0.8)",
                    borderColor: "rgba(255,255,255,0.2)",
                    fontSize: "0.75rem",
                  }}
                >
                  30/15
                </Button>
                <Button
                  onClick={() => _applyPreset("RUNNING_CLOCK")}
                  sx={{
                    color: "rgba(255,255,255,0.8)",
                    borderColor: "rgba(255,255,255,0.2)",
                    fontSize: "0.75rem",
                  }}
                >
                  Clock
                </Button>
              </ButtonGroup>
            </Stack>
          </Box>
        </CardContent>
      </Card>

      {/* 2. Spotify Controls */}
      <Card sx={{ mb: 3, boxShadow: 2 }}>
        <CardContent sx={{ p: 3 }}>
          <Typography
            variant="h6"
            sx={{
              display: "flex",
              alignItems: "center",
              fontWeight: 600,
              mb: 2,
            }}
          >
            <MusicNote sx={{ mr: 1 }} /> Music
          </Typography>
              </Typography>
              <Stack
                direction="row"
                alignItems="center"
                justifyContent="center"
                spacing={3}
              >
                {" "}
                {/* Increased spacing */}
                <IconButton
                  color="primary"
                  onClick={() => setWorkTime((prev) => Math.max(0, prev - 5))}
                  aria-label="Decrease work duration"
                  sx={{
                    backgroundColor: "grey.700",
                    color: "white",
                    "&:hover": { backgroundColor: "grey.600" },
                    p: 3,
                    "&:focus-visible": {
                      outline: "3px solid",
                      outlineColor: "primary.main",
                      outlineOffset: "2px",
                    },
                  }} // Increased padding
                >
                  <Remove fontSize="large" />
                </IconButton>
                <TextField
                  type="number"
                  variant="outlined"
                  value={workTime}
                  onChange={(e) => {
                    const value = parseInt(e.target.value, 10);
                    if (!isNaN(value) && value >= 0) {
                      setWorkTime(value);
                      setIsValidWorkTime(true);
                    } else {
                      setIsValidWorkTime(false);
                    }
                  }}
                  onFocus={(e) => e.target.select()} // Select all text on focus
                  inputRef={workTimeInputRef}
                  error={!isValidWorkTime}
                  helperText={
                    !isValidWorkTime
                      ? "Work time must be a non-negative number"
                      : ""
                  }
                  inputProps={{
                    min: 0,
                    style: {
                      textAlign: "center",
                      fontSize: "3rem",
                      fontWeight: "bold",
                      color: "red",
                      minWidth: "100px",
                      padding: "8px 0", // Adjust padding to visually match Typography
                    },
                  }}
                  sx={{
                    "& .MuiOutlinedInput-notchedOutline": {
                      borderColor: "transparent", // Hide border
                    },
                    "&:hover .MuiOutlinedInput-notchedOutline": {
                      borderColor: "transparent", // Hide border on hover
                    },
                    "&.Mui-focused .MuiOutlinedInput-notchedOutline": {
                      borderColor: "transparent", // Hide border on focus
                    },
                    "& .MuiInputBase-input": {
                      // Target the input element directly
                      height: "auto", // Allow content to dictate height
                    },
                  }}
                  aria-label="Work duration in seconds"
                />
                <IconButton
                  color="primary"
                  onClick={() => setWorkTime((prev) => prev + 5)}
                  aria-label="Increase work duration"
                  sx={{
                    backgroundColor: "grey.700",
                    color: "white",
                    "&:hover": { backgroundColor: "grey.600" },
                    p: 3,
                    "&:focus-visible": {
                      outline: "3px solid",
                      outlineColor: "primary.main",
                      outlineOffset: "2px",
                    },
                  }} // Increased padding
                >
                  <Add fontSize="large" />
                </IconButton>
              </Stack>
            </Box>
            {/* Rest Duration Stepper */}
            <Box>
              <Typography sx={{ color: "white", fontWeight: "medium", mb: 2 }}>
                {" "}
                {/* Increased mb */}
                Rest Duration (seconds)
              </Typography>
              <Stack
                direction="row"
                alignItems="center"
                justifyContent="center"
                spacing={3}
              >
                {" "}
                {/* Increased spacing */}
                <IconButton
                  color="primary"
                  onClick={() => setRestTime((prev) => Math.max(0, prev - 5))}
                  aria-label="Decrease rest duration"
                  sx={{
                    backgroundColor: "grey.700",
                    color: "white",
                    "&:hover": { backgroundColor: "grey.600" },
                    p: 3,
                    "&:focus-visible": {
                      outline: "3px solid",
                      outlineColor: "primary.main",
                      outlineOffset: "2px",
                    },
                  }} // Increased padding
                >
                  <Remove fontSize="large" />
                </IconButton>
                <TextField
                  type="number"
                  variant="outlined"
                  value={restTime}
                  onChange={(e) => {
                    const value = parseInt(e.target.value, 10);
                    if (!isNaN(value) && value >= 0) {
                      setRestTime(value);
                      setIsValidRestTime(true);
                    } else {
                      setIsValidRestTime(false);
                    }
                  }}
                  onFocus={(e) => e.target.select()} // Select all text on focus
                  inputRef={restTimeInputRef}
                  error={!isValidRestTime}
                  helperText={
                    !isValidRestTime
                      ? "Rest time must be a non-negative number"
                      : ""
                  }
                  inputProps={{
                    min: 0,
                    style: {
                      textAlign: "center",
                      fontSize: "3rem",
                      fontWeight: "bold",
                      color: "red",
                      minWidth: "100px",
                      padding: "8px 0", // Adjust padding to visually match Typography
                    },
                  }}
                  sx={{
                    "& .MuiOutlinedInput-notchedOutline": {
                      borderColor: "transparent", // Hide border
                    },
                    "&:hover .MuiOutlinedInput-notchedOutline": {
                      borderColor: "transparent", // Hide border on hover
                    },
                    "&.Mui-focused .MuiOutlinedInput-notchedOutline": {
                      borderColor: "transparent", // Hide border on focus
                    },
                    "& .MuiInputBase-input": {
                      // Target the input element directly
                      height: "auto", // Allow content to dictate height
                    },
                  }}
                  aria-label="Rest duration in seconds"
                />
                <IconButton
                  color="primary"
                  onClick={() => setRestTime((prev) => prev + 5)}
                  aria-label="Increase rest duration"
                  sx={{
                    backgroundColor: "grey.700",
                    color: "white",
                    "&:hover": { backgroundColor: "grey.600" },
                    p: 3,
                    "&:focus-visible": {
                      outline: "3px solid",
                      outlineColor: "primary.main",
                      outlineOffset: "2px",
                    },
                  }} // Increased padding
                >
                  <Add fontSize="large" />
                </IconButton>
              </Stack>
            </Box>
          </Stack>

          {/* Timer Presets */}
          <ButtonGroup
            fullWidth
            variant="outlined"
            aria-label="Timer presets"
            sx={{ mb: 4 }}
          >
            <Button
              onClick={() => _applyPreset("EMOM_20_10")}
              sx={{
                color: "white",
                borderColor: "grey.700",
                "&:hover": { borderColor: "grey.600" },
              }}
            >
              EMOM 20/10
            </Button>
            <Button
              onClick={() => _applyPreset("EMOM_30_15")}
              sx={{
                color: "white",
                borderColor: "grey.700",
                "&:hover": { borderColor: "grey.600" },
              }}
            >
              EMOM 30/15
            </Button>
            <Button
              onClick={() => _applyPreset("RUNNING_CLOCK")}
              sx={{
                color: "white",
                borderColor: "grey.700",
                "&:hover": { borderColor: "grey.600" },
              }}
            >
              Running Clock
            </Button>
          </ButtonGroup>

          {/* Timer Control Buttons */}
          <ButtonGroup
            fullWidth
            variant="contained"
            aria-label="Timer control buttons"
            sx={{ mt: 4 }}
          >
            <Button
              color="success"
              onClick={() => _sendTimerCommand("START")}
              disabled={connectionStatus !== "Connected"}
              sx={{
                flex: 1,
                fontWeight: "bold",
                minHeight: 48,
                py: 3,
                "&:focus-visible": {
                  outline: "3px solid",
                  outlineColor: "primary.main",
                  outlineOffset: "2px",
                },
              }}
              startIcon={<PlayArrow fontSize="large" />}
            >
              START
            </Button>
            <Button
              color="error"
              onClick={() => _sendTimerCommand("STOP")}
              disabled={connectionStatus !== "Connected"}
              sx={{
                flex: 1,
                fontWeight: "bold",
                minHeight: 48,
                py: 3,
                "&:focus-visible": {
                  outline: "3px solid",
                  outlineColor: "primary.main",
                  outlineOffset: "2px",
                },
              }}
              startIcon={<Stop fontSize="large" />}
            >
              STOP
            </Button>
          </ButtonGroup>
        </CardContent>
      </Card>

      {/* 2. Spotify Controls */}
      <Card
        sx={{
          elevation: 6,
          p: 2,
          mb: 3,
          backgroundColor: "grey.800",
          color: "white",
        }}
      >
        <Typography
          variant="h6"
          sx={{
            display: "flex",
            alignItems: "center",
            fontWeight: "semibold",
            mb: 1.5,
            color: "grey.200",
          }}
        >
          <MusicNote sx={{ mr: 1 }} aria-hidden="true" /> Spotify Player
        </Typography>

        {spotifyLoggedIn ? (
          <CardContent sx={{ p: 0 }}>
            <Typography variant="subtitle1" sx={{ fontWeight: "medium" }}>
              {spotifyData.trackName}
            </Typography>
            <Typography
              variant="body2"
              color="textSecondary"
              sx={{ color: "grey.400", mb: 3 }}
            >
              by {spotifyData.artist}
            </Typography>

            {/* Spotify Device Selection */}
            <FormControl fullWidth variant="outlined" sx={{ mb: 4 }}>
              <InputLabel
                id="spotify-device-select-label"
                sx={{ color: "grey.400" }}
              >
                Active Device
              </InputLabel>
              <Select
                labelId="spotify-device-select-label"
                value={selectedDeviceId}
                onChange={(e) => {
                  const newDeviceId = e.target.value as string;
                  setSelectedDeviceId(newDeviceId);
                  sendSpotifyCommand("TRANSFER_PLAYBACK", newDeviceId);
                }}
                label="Active Device"
                sx={{
                  color: "white",
                  "& .MuiOutlinedInput-notchedOutline": {
                    borderColor: "grey.600",
                  },
                  "&:hover .MuiOutlinedInput-notchedOutline": {
                    borderColor: "grey.400",
                  },
                  "&.Mui-focused .MuiOutlinedInput-notchedOutline": {
                    borderColor: "white",
                  },
                  "& .MuiSvgIcon-root": { color: "grey.400" }, // Dropdown arrow color
                }}
                disabled={devicesLoading || availableDevices.length === 0}
              >
                {devicesLoading && (
                  <MenuItem value="" disabled>
                    Loading devices...
                  </MenuItem>
                )}
                {devicesError && (
                  <MenuItem value="" disabled>
                    Error: {devicesError}
                  </MenuItem>
                )}
                {availableDevices.length === 0 &&
                  !devicesLoading &&
                  !devicesError && (
                    <MenuItem value="" disabled>
                      No devices found
                    </MenuItem>
                  )}
                {availableDevices.map((device) => (
                  <MenuItem key={device.id} value={device.id}>
                    {device.name} ({device.type}){" "}
                    {device.is_active ? "(Active)" : ""}
                  </MenuItem>
                ))}
              </Select>
            </FormControl>

            {/* Web Playback SDK Integration - Always visible */}
            <Box sx={{ mb: 4 }}>
              {isReady && deviceId ? (
                <Stack spacing={2}>
                  <Typography variant="body2" sx={{ color: "success.light" }}>
                    ✓ Browser player ready
                  </Typography>
                  <Button
                    variant="contained"
                    color="primary"
                    fullWidth
                    onClick={() => {
                      if (deviceId) {
                        sendSpotifyCommand("TRANSFER_PLAYBACK", deviceId);
                        setSelectedDeviceId(deviceId);
                      }
                    }}
                    sx={{ minHeight: 48 }}
                  >
                    Play in Browser
                  </Button>
                </Stack>
              ) : webPlaybackError ? (
                <Typography variant="body2" sx={{ color: "error.light" }}>
                  Web Player Error: {webPlaybackError}
                </Typography>
              ) : (
                <Typography variant="body2" sx={{ color: "grey.400" }}>
                  Initializing browser player...
                </Typography>
              )}
            </Box>

            <Stack
              direction="row"
              spacing={3}
              justifyContent="center"
              sx={{ mb: 4 }}
            >
              <IconButton
                size="large"
                sx={{
                  color: "white",
                  "&:hover": { backgroundColor: "grey.700" },
                  "&:focus-visible": {
                    outline: "3px solid",
                    outlineColor: "primary.main",
                    outlineOffset: "2px",
                  },
                }}
                onClick={() => sendSpotifyCommand("PREVIOUS")}
                disabled={connectionStatus !== "Connected"}
                aria-label="Previous track"
              >
                <SkipPrevious fontSize="large" />
              </IconButton>
              <IconButton
                size="large"
                color="success"
                sx={{
                  backgroundColor: "success.main",
                  "&:hover": { backgroundColor: "success.dark" },
                  color: "white",
                  "&:focus-visible": {
                    outline: "3px solid",
                    outlineColor: "primary.main",
                    outlineOffset: "2px",
                  },
                }}
                onClick={() => sendSpotifyCommand("PLAY")}
                disabled={connectionStatus !== "Connected"}
                aria-label="Play"
              >
                <PlayArrow fontSize="large" />
              </IconButton>
              <IconButton
                size="large"
                sx={{
                  color: "white",
                  "&:hover": { backgroundColor: "grey.700" },
                  "&:focus-visible": {
                    outline: "3px solid",
                    outlineColor: "primary.main",
                    outlineOffset: "2px",
                  },
                }}
                onClick={() => sendSpotifyCommand("NEXT")}
                disabled={connectionStatus !== "Connected"}
                aria-label="Next track"
              >
                <SkipNext fontSize="large" />
              </IconButton>
            </Stack>

            {/* Volume Control */}
            <Box sx={{ px: 2 }}>
              <Stack direction="row" spacing={2} alignItems="center">
                <VolumeUp sx={{ color: "grey.400" }} aria-hidden="true" />
                <Slider
                  aria-label="Volume"
                  value={volume}
                  onChange={(_: Event, newValue: number | number[]) =>
                    setVolume(newValue as number)
                  }
                  min={0}
                  max={100}
                  valueLabelDisplay="auto"
                  getAriaValueText={(value) => `Volume: ${value}%`}
                  sx={{
                    color: "grey.400",
                    "& .MuiSlider-thumb": {
                      backgroundColor: "white",
                      width: 24, // Increased thumb size
                      height: 24, // Increased thumb size
                      mt: -8, // Adjust margin to keep thumb centered
                      ml: -12, // Adjust margin to keep thumb centered
                    },
                  }}
                />
                <Typography
                  variant="body2"
                  sx={{ color: "grey.400", minWidth: "3ch" }}
                >
                  {volume}
                </Typography>
              </Stack>
            </Box>

            {/* Logout Button */}
            <Button
              variant="outlined"
              color="error"
              onClick={handleSpotifyLogout}
              sx={{
                width: "100%",
                mt: 3,
                borderColor: "error.main",
                color: "error.main",
                "&:hover": {
                  backgroundColor: "error.dark",
                  borderColor: "error.dark",
                  color: "white",
                },
                "&:focus-visible": {
                  outline: "3px solid",
                  outlineColor: "error.main",
                  outlineOffset: "2px",
                },
              }}
            >
              Sign Out of Spotify
            </Button>
          </CardContent>
        ) : (
          <Button
            variant="contained"
            color="success"
            onClick={handleSpotifyLogin}
            sx={{
              width: "100%",
              mt: 2,
              "&:focus-visible": {
                outline: "3px solid",
                outlineColor: "primary.main",
                outlineOffset: "2px",
              },
            }}
          >
            Login with Spotify
          </Button>
        )}
      </Card>
    </Container>
  );
};

export default ControlPanel;
