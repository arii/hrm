{
  "name": "hrm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "./node_modules/.bin/pm2 start server.ts --interpreter ./node_modules/.bin/ts-node --watch",
    "dev:server": "./node_modules/.bin/pm2 start server.ts --interpreter ./node_modules/.bin/ts-node --watch",
    "dev:clean": "HOST=127.0.0.1 NODE_ENV=development ./node_modules/.bin/pm2 start server.ts --interpreter ./node_modules/.bin/ts-node --watch",
    "build": "next build",
    "start": "./node_modules/.bin/pm2 start ecosystem.config.js --env production",
    "pm2:prod": "./node_modules/.bin/pm2 start ecosystem.config.js --env production",
    "pm2:stop": "./node_modules/.bin/pm2 stop ecosystem.config.js",
    "pm2:delete": "./node_modules/.bin/pm2 delete ecosystem.config.js",
    "pm2:logs": "./node_modules/.bin/pm2 logs",
    "lint": "eslint"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.5",
    "@mui/material": "^7.3.5",
    "express": "^5.1.0",
    "next": "16.0.1",
    "next-auth": "^4.24.13",
    "node-fetch": "^3.3.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^20.19.24",
    "@types/node-fetch": "^2.6.13",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "pm2": "^5.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
