{
  "name": "hrm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:server": "tsc -p tsconfig.build.json",
    "dev": "cross-env NODE_ENV=development HOST=127.0.0.1 ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' server.ts",
    "dev:server": "cross-env NODE_ENV=development HOST=127.0.0.1 ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' server.ts",
    "dev:clean": "cross-env NODE_ENV=development HOST=127.0.0.1 ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' server.ts",
    "build": "next build",
    "start": "./node_modules/.bin/pm2 start ecosystem.config.js --env production",
    "pm2:prod": "./node_modules/.bin/pm2 start ecosystem.config.js --env production",
    "pm2:stop": "./node_modules/.bin/pm2 stop ecosystem.config.js",
    "pm2:delete": "./node_modules/.bin/pm2 delete ecosystem.config.js",
    "pm2:logs": "./node_modules/.bin/pm2 logs",
    "lint": "eslint",
    "mcp:chrome-devtools": "npx -y chrome-devtools-mcp@latest --isolated --browser-url=http://1.0.0.1:9222",
    "mcp:chrome-devtools:headless": "npx -y chrome-devtools-mcp@latest --isolated --headless=true --browser-url=http://1.0.0.1:9222"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^5.15.0",
    "@mui/material": "^5.15.0",
    "express": "^5.1.0",
    "next": "14.2.3",
    "next-auth": "^4.24.13",
    "node-fetch": "^3.3.2",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/node-fetch": "^2.6.13",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/ws": "^8.18.1",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.1",
    "pm2": "^5.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
