{
  "name": "hrm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file=.env.local --watch server.ts",
    "build": "pnpm run build:server && next build",
    "build:server": "pnpm exec tsc -p tsconfig.build.json && cp dist/server.js dist/server.mjs",
    "start": "node dist/server.mjs",
    "lint": "eslint app/ components/ constants/ context/ hooks/ lib/ services/ tests/ types/ utils/ server.ts middleware.ts --cache",
    "test:unit": "jest tests/unit --coverage",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots"
  },
  "dependencies": {
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@mui/material": "^5.16.5",
    "@prisma/client": "^5.17.0",
    "@spotify/web-api-ts-sdk": "^1.2.0",
    "express": "^4.19.2",
    "express-rate-limit": "^6.11.2",
    "next": "16.0.1",
    "next-auth": "^4.24.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@playwright/test": "^1.45.3",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.12",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.11",
    "@typescript-eslint/eslint-plugin": "^7.17.0",
    "@typescript-eslint/parser": "^7.17.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.3",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^16.0.0",
    "prettier": "^3.3.3",
    "prisma": "^5.17.0",
    "ts-jest": "^29.2.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^7.17.0"
  },
  "packageManager": "pnpm@9.1.1",
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "ANALYZE": "true"
}
