{
  "name": "hrm",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf .next dist coverage test-results playwright-report *.log *.backup nohup.out diff.txt",
    "prebuild": "pnpm run clean",
    "dev": "NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true node --env-file=.env.local --loader ts-node/esm server.ts | pnpm exec pino-pretty",
    "seed": "ts-node --esm scripts/seed-dev-data.ts",
    "build": "pnpm run build:server && next build",
    "build:server": "pnpm exec tsc -p tsconfig.build.json && mv dist/server.js dist/server.mjs",
    "analyze": "ANALYZE=true pnpm run build:server && ANALYZE=true next build --webpack",
    "start": "pm2 start ecosystem.config.cjs --env production",
    "profile:server": "bash scripts/profile-server.sh",
    "profile:frontend": "bash scripts/profile-frontend.sh",
    "profile:all": "pnpm run profile:server && pnpm run profile:frontend",
    "pm2:logs": "pm2 logs hrm-server",
    "pm2:stop": "pm2 stop hrm-server",
    "pm2:restart": "pm2 restart hrm-server",
    "pm2:delete": "pm2 delete hrm-server",
    "lint": "eslint app/ components/ constants/ context/ hooks/ lib/ services/ tests/ types/ utils/ server.ts middleware.ts --cache",
    "lint:fix": "eslint app/ components/ constants/ context/ hooks/ lib/ services/ tests/ types/ utils/ server.ts middleware.ts --fix --cache",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm run test:all",
    "test:unit": "NEXTAUTH_SECRET=test-secret-unit jest tests/unit --coverage",
    "test:unit:watch": "jest tests/unit --watch",
    "test:json": "scripts/test-json-with-server.sh",
    "test:visual": "scripts/test-with-server.sh playwright test tests/playwright/visual-regression.spec.ts tests/playwright/remote-capabilities.spec.ts tests/playwright/simple-smoke.spec.ts  tests/playwright/debug.spec.ts",
    "test:all": "pnpm run test:visual && pnpm run test:unit",
    "test:quick": "pnpm run build && scripts/test-with-server.sh playwright test --reporter=dot",
    "test:visual:ui": "playwright test --ui",
    "test:visual:update": "scripts/test-with-server.sh playwright test --update-snapshots --reporter=dot",
    "test:visual:headed": "playwright test --project=chromium --headed",
    "test:visual:report": "playwright show-report",
    "test:oauth:local": "python3 scripts/verify_oauth_local.py",
    "test:oauth:playwright": "playwright test --config=playwright.oauth.config.ts",
    "test:remote": "scripts/test-with-server.sh playwright test remote-capabilities --project=chromium",
    "test:perf": "scripts/test-with-server.sh playwright test tests/playwright/performance.spec.ts --project=chromium",
    "test:perf:debug": "cross-env PWDEBUG=1 pnpm run test:perf",
    "verify:spotify": "bash scripts/verify-spotify.sh",
    "kill-all": "./scripts/kill-all.sh",
    "test:clean": "pnpm run kill-all && pnpm run dev & sleep 5 && pnpm run test:visual",
    "test:clean:update": "pnpm run kill-all && pnpm run dev & sleep 5 && pnpm run test:visual:update",
    "mcp:chrome-devtools": "npx -y chrome-devtools-mcp@latest --isolated --browser-url=http://1.0.0.1:9222",
    "release:patch": "pnpm version patch -m \"release: patch %s\"",
    "release:minor": "pnpm version minor -m \"release: minor %s\"",
    "release:major": "pnpm version major -m \"release: major %s\"",
    "test:infra": "playwright test tests/playwright/infrastructure.spec.ts",
    "verify": "node scripts/verify-and-publish.cjs",
    "commit:verified": "pnpm run verify",
    "depcheck": "depcheck",
    "storybook": "storybook dev -p 6006 --open",
    "build-storybook": "storybook build",
    "verify:storybook": "pnpm exec ts-node --esm scripts/verify-storybook-setup.ts",
    "generate:openapi": "ts-node --esm scripts/generate-openapi.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.2.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@google/genai": "1.33.0",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@react-spring/web": "^10.0.3",
    "@spotify/web-api-ts-sdk": "^1.2.0",
    "cheerio": "^1.1.2",
    "express": "^4.19.2",
    "express-rate-limit": "^8.2.1",
    "framer-motion": "^12.23.24",
    "helmet": "^8.1.0",
    "js-cookie": "^3.0.5",
    "lodash": "^4.17.21",
    "next": "15.5.9",
    "next-auth": "^4.24.13",
    "pino": "^10.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "ws": "^8.18.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@actions/core": "2.0.1",
    "@actions/github": "6.0.1",
    "@chromatic-com/storybook": "^4.1.3",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/js": "^9.39.1",
    "@google/generative-ai": "0.24.1",
    "@jest/globals": "^30.2.0",
    "@next/bundle-analyzer": "^16.0.5",
    "@playwright/test": "^1.57.0",
    "@storybook/addon-a11y": "^10.1.4",
    "@storybook/addon-actions": "^8.6.14",
    "@storybook/addon-docs": "^10.1.4",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-onboarding": "^10.1.4",
    "@storybook/addon-vitest": "^10.1.4",
    "@storybook/blocks": "^8.6.14",
    "@storybook/nextjs": "^8.6.14",
    "@storybook/nextjs-vite": "^10.1.4",
    "@storybook/react": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash": "^4.17.21",
    "@types/next": "^8.0.7",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/web-bluetooth": "^0.0.21",
    "@types/ws": "^8.18.1",
    "@vitest/browser-playwright": "^4.0.15",
    "@vitest/coverage-v8": "^4.0.15",
    "babel-plugin-react-compiler": "1.0.0",
    "clinic": "^13.0.0",
    "depcheck": "^1.4.7",
    "eslint": "9.39.2",
    "eslint-config-next": "15.5.9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-storybook": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-junit": "^16.0.0",
    "lint-staged": "^16.2.7",
    "msw": "^2.12.4",
    "msw-storybook-addon": "^2.0.6",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.57.0",
    "pm2": "^5.2.0",
    "prettier": "^3.6.2",
    "storybook": "^8.6.14",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsx": "4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "vite": "^7.2.7",
    "vitest": "^4.0.15",
    "wait-on": "^9.0.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "depcheck": {
    "ignores": [
      "@types/web-bluetooth",
      "cross-env",
      "jest-environment-jsdom"
    ]
  },
  "pnpm": {
    "overrides": {
      "loader-utils@<1.4.1": ">=1.4.1",
      "loader-utils@>=1.0.0 <1.4.2": ">=1.4.2",
      "node-fetch@<2.6.7": ">=2.6.7",
      "node-fetch@>=2.0.0 <2.6.1": ">=2.6.1",
      "path-to-regexp@>=2.0.0 <3.3.0": ">=3.3.0",
      "cookie@<0.7.0": ">=0.7.0",
      "on-headers@<1.1.0": ">=1.1.0",
      "send@<0.19.0": ">=0.19.0",
      "next@>=16.0.0-canary.0 <16.0.7": ">=16.0.7"
    }
  }
}
