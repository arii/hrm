{
  "name": "hrm",
  "version": "0.18.0",
  "private": true,
  "description": "Heartrate monitor server client and other fitness tools",
  "author": {
    "name": "Ariel Anders",
    "email": "anders.ariel@gmail.com"
  },
  "scripts": {
    "dev": "node --env-file=.env.local --loader ts-node/esm ./server.ts",
    "build": "pnpm run build:server && next build",
    "build:server": "pnpm exec tsc -p tsconfig.build.json",
    "start": "NODE_ENV=production node --env-file=.env.production dist/server.js",
    "lint": "eslint app/ components/ constants/ context/ hooks/ lib/ services/ tests/ types/ utils/ server.ts proxy.ts --cache",
    "lint:fix": "pnpm run lint --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,css}\"",
    "test": "cross-env TESTING=true pnpm run test:unit",
    "test:unit": "cross-env NEXTAUTH_SECRET=test-secret-unit jest tests/unit --coverage",
    "test:unit:watch": "pnpm run test:unit --watch",
    "test:e2e": "bash ./scripts/e2e-test.sh",
    "test:ci": "pnpm run test:unit --ci --runInBand",
    "test:visual": "pnpm run test:visual:run --",
    "test:visual:run": "playwright test --project=visual-regression",
    "test:visual:update": "pnpm run test:visual:run --update-snapshots",
    "test:quick": "playwright test --project=quick-tests",
    "prepare": "husky",
    "clean": "rm -rf .next dist coverage test-results playwright-report *.log *.backup nohup.out diff.txt",
    "prebuild": "pnpm run clean",
    "seed": "ts-node --esm scripts/seed-dev-data.ts",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop hrm-server || true",
    "pm2:delete": "pm2 delete hrm-server || true",
    "pm2:restart": "pm2 restart hrm-server --update-env",
    "pm2:logs": "pm2 logs hrm-server",
    "deploy": "bash ./scripts/deploy.sh",
    "verify:spotify": "bash ./scripts/verify-spotify-token.sh",
    "analyze": "cross-env ANALYZE=true pnpm run build"
  },
  "dependencies": {
    "@emotion/cache": "^11.11.0",
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/icons-material": "^5.15.19",
    "@mui/material": "^5.15.19",
    "@mui/material-nextjs": "^5.15.11",
    "@prisma/client": "^5.14.0",
    "@spotify/web-api-ts-sdk": "^1.2.0",
    "@types/jest-json-schema": "^6.1.4",
    "@types/ws": "^8.5.10",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.0",
    "http-proxy-middleware": "^3.0.0",
    "nanoid": "^5.0.0",
    "next": "15.0.0-rc.0",
    "next-auth": "5.0.0-beta.18",
    "pino": "^9.1.0",
    "pino-http": "^10.1.0",
    "react": "19.0.0-rc-f994737d14-20240522",
    "react-dom": "19.0.0-rc-f994737d14-20240522",
    "ws": "^8.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.24.6",
    "@babel/preset-typescript": "^7.24.6",
    "@faker-js/faker": "^8.4.1",
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.44.1",
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^16.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/nanoid": "^3.0.0",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.11.0",
    "@typescript-eslint/parser": "^7.11.0",
    "babel-jest": "^29.7.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.3",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^16.0.0",
    "jest-mock-extended": "^3.0.7",
    "lint-staged": "^15.2.5",
    "pino-pretty": "^11.1.0",
    "prettier": "^3.2.5",
    "prisma": "^5.14.0",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --cache --fix",
      "prettier --write"
    ]
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "es5"
  }
}
