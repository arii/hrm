# .env.example
# Copy this file to .env.local and fill in the values.

# -- Next.js --
# The environment your application is running in. (e.g. 'development', 'production')
NODE_ENV=development

# -- Server --
# The port the server will run on.
PORT=3000
# The host the server will bind to.
HOST=127.0.0.1

# -- Authentication --
# A secret key for NextAuth.js. Generate one with `openssl rand -base64 32`
NEXTAUTH_SECRET=
# The public-facing base URL of your application.
NEXTAUTH_URL=http://127.0.0.1:3000

# -- Spotify API --
# Your Spotify application's Client ID.
SPOTIFY_CLIENT_ID=
# Your Spotify application's Client Secret.
SPOTIFY_CLIENT_SECRET=
# The callback URL for Spotify authentication.
# For local dev, this *must* match what's in your Spotify Developer Dashboard.
SPOTIFY_CALLBACK_URL=http://127.0.0.1:3000/callback

# A 64-character hex string used to encrypt/decrypt Spotify tokens stored on disk.
# Generate one with `openssl rand -hex 32`.
ENCRYPTION_KEY=

# Controls Spotify token persistence.
# - 'ephemeral': (Default) Tokens are held in memory and lost on restart.
# - 'persistence': Tokens are encrypted and saved to `logs/spotify_tokens.json`.
SPOTIFY_TOKEN_CACHE_STRATEGY=ephemeral

# -- Internal API --
# A secret for internal token delivery.
INTERNAL_TOKEN_DELIVERY_SECRET=

# -- Debugging --
# Set to 'true' or '1' to enable verbose Spotify service logging.
SPOTIFY_DEBUG=false

# -- Testing --
# Set to 'true' when running tests to bypass rate limiting and relax env var validation.
TESTING=false

# -- CI/CD --
# Set to 'true' in a CI environment.
CI=false
