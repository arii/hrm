# .env.example
# Copy this file to .env and fill in the values.

# -- Next.js --
# The environment your application is running in. (e.g. 'development', 'production')
NODE_ENV=development

# -- Server --
# The port the server will run on.
PORT=3000
# The host the server will bind to.
HOST=127.0.0.1

# -- Authentication --
# A secret key for NextAuth.js. Generate one with `openssl rand -hex 32`
NEXTAUTH_SECRET=
# The base URL of your application.
NEXTAUTH_URL=http://127.0.0.1:3000
# An alternative base URL of your application.
BASE_URL=http://127.0.0.1:3000

# -- Spotify API --
# Your Spotify application's Client ID.
SPOTIFY_CLIENT_ID=
# Your Spotify application's Client Secret.
SPOTIFY_CLIENT_SECRET=
# The callback URL for Spotify authentication.
SPOTIFY_CALLBACK_URL=http://127.0.0.1:3000/api/auth/callback/spotify

# -- Internal API --
# A secret for internal token delivery.
INTERNAL_TOKEN_DELIVERY_SECRET=

# -- Debugging --
# Set to 'true' or '1' to enable Spotify debugging.
SPOTIFY_DEBUG=false

# -- CI/CD --
# Set to 'true' in a CI environment.
CI=false

# -- Sentry --
# Your Sentry DSN for client-side error reporting.
NEXT_PUBLIC_SENTRY_DSN=
# Your Sentry DSN for server-side error reporting.
SENTRY_DSN=
# Your Sentry organization slug.
SENTRY_ORG=
# Your Sentry project slug.
SENTRY_PROJECT=
# The sample rate for Sentry traces. (1.0 = 100%, 0.1 = 10%)
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=1.0
# The sample rate for Sentry session replays. (1.0 = 100%, 0.1 = 10%)
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0
