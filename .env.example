# Required environment variables for all environments
# Generate a secret with `openssl rand -hex 32`
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://127.0.0.1:3000

# Required for Spotify integration
# See https://developer.spotify.com/documentation/web-api/
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_CALLBACK_URL=http://127.0.0.1:3000/callback

# Optional: Set to "true" or "1" to enable verbose logging for Spotify polling
# Useful for debugging playback state issues
SPOTIFY_DEBUG=false

# Optional: Set to "true" or "1" to persist Spotify tokens to disk (logs/spotify_tokens.json)
# This allows the server to resume Spotify polling after a restart without re-authentication
SPOTIFY_TOKEN_PERSISTENCE=false

# Required: A 64-character hex string for encrypting Spotify tokens
# Generate with `openssl rand -hex 32`
ENCRYPTION_KEY=

# Optional: The interval (in ms) to check for stale WebSocket connections
WEBSOCKET_WATCHDOG_INTERVAL=30000
