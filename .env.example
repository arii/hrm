# Required by NextAuth.js
# Generate a secret with: openssl rand -hex 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Required by Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_POLLING_INTERVAL_MS=3000
# Optional: Enable verbose logging for SpotifyPolling service
SPOTIFY_DEBUG=false
# Optional: Set to 'true' or '1' to persist tokens to logs/spotify_tokens.json
# THIS IS INSECURE and for debugging only.
SPOTIFY_TOKEN_PERSISTENCE=false

# Required by Prisma
DATABASE_URL="file:./prisma/dev.db"
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: Port to run the application on
PORT=3000
