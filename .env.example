# .env.example
# Copy this file to .env and fill in the values.

# -- Next.js --
# The environment your application is running in. (e.g. 'development', 'production')
NODE_ENV=development

# -- Server --
# The port the server will run on.
PORT=3000
# The host the server will bind to.
HOST=127.0.0.1

# -- Authentication --
# A secret key for NextAuth.js. Generate one with `openssl rand -hex 32`
NEXTAUTH_SECRET=
# The base URL of your application.
NEXTAUTH_URL=http://127.0.0.1:3000
# An alternative base URL of your application.
BASE_URL=http://127.0.0.1:3000

# -- Spotify API --
# Your Spotify application's Client ID.
SPOTIFY_CLIENT_ID=
# Your Spotify application's Client Secret.
SPOTIFY_CLIENT_SECRET=
# The callback URL for Spotify authentication.
SPOTIFY_CALLBACK_URL=http://127.0.0.1:3000/api/auth/callback/spotify

# -- Internal API --
# A secret for internal token delivery.
INTERNAL_TOKEN_DELIVERY_SECRET=

# -- Rate Limiting --
# Maximum number of requests to the Spotify API within the defined window. Default: 30
RATE_LIMIT_SPOTIFY_MAX=
# Time window in minutes for Spotify API rate limiting. Default: 1
RATE_LIMIT_SPOTIFY_WINDOW_MINUTES=
# Maximum number of requests to internal APIs within the defined window. Default: 100
RATE_LIMIT_INTERNAL_MAX=
# Time window in minutes for internal API rate limiting. Default: 1
RATE_LIMIT_INTERNAL_WINDOW_MINUTES=
# Maximum number of requests to general APIs within the defined window. Default: 200
RATE_LIMIT_GENERAL_MAX=
# Time window in minutes for general API rate limiting. Default: 1
RATE_LIMIT_GENERAL_WINDOW_MINUTES=
# Maximum number of authentication requests within the defined window. Default: 10
RATE_LIMIT_AUTH_MAX=
# Time window in minutes for authentication request rate limiting. Default: 5
RATE_LIMIT_AUTH_WINDOW_MINUTES=
# Maximum number of WebSocket connections per IP. Default: 5
WS_MAX_CONNECTIONS=
# Upstash Redis REST URL
UPSTASH_REDIS_REST_URL=
# Upstash Redis REST Token
UPSTASH_REDIS_REST_TOKEN=

# -- Debugging --
# Set to 'true' or '1' to enable Spotify debugging.
SPOTIFY_DEBUG=false

# -- CI/CD --
# Set to 'true' in a CI environment.
CI=false

# -- Google Docs --
# The URL of the public Google Doc to be parsed for workout data.
GOOGLE_DOC_WORKOUT_URL="https://docs.google.com/document/d/e/2PACX-1vTev5AMiHYi2Jkg9x6zRQoiJ_o2X_wZMqAXVpwgjlSqzlcXelxSc7psjE8n3N-ghzXMFtnv51nc2fJZ/pub?embedded=true"
# Feature Flag for Workout Table
NEXT_PUBLIC_USE_NATIVE_TABLE=false
