#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Run commitlint; if it fails, print a warning but exit 0 (success)
npx --no -- commitlint --edit "$1" || {
  echo ""
  echo "⚠️  Commit message validation failed, but proceeding with commit."
  echo "    Please review project guidelines for future commits."
  echo ""
  exit 0
}
