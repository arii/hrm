{
  "extends": "./tsconfig.json",
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    "**/*.mts",
    "**/*.cjs",
    "**/*.mjs",
    "playwright.config.ts",
    "tests/**/*.ts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", "out", "build", "dist"]
}
