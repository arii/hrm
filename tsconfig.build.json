{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "module": "esnext",
    "moduleResolution": "node",
    "target": "esnext",
    "esModuleInterop": true,
    "traceResolution": false
  },
  "include": [
    "server.ts",
    "services/**/*.ts",
    "utils/**/*.ts",
    "types/**/*.ts",
    "lib/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["lib/fit-generator.ts", "lib/export/fit-generator.ts"]
}
