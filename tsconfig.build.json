{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "src",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "traceResolution": false
  },
  "include": [
    "src/server.ts",
    "src/services/**/*.ts",
    "src/utils/**/*.ts",
    "src/types/**/*.ts",
    "src/lib/**/*.ts"
  ]
}
