{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "traceResolution": false,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["server.ts", "services/**/*.ts", "utils/**/*.ts", "types/**/*.ts", "lib/**/*.ts"]
}
