{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "traceResolution": false
  },
  "include": ["server.ts", "services/**/*.ts", "utils/**/*.ts", "types/**/*.ts"],
  "exclude": ["services/__mocks__/**/*", "tests/**/*"]
}
