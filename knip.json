{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "server.ts",
    "proxy.ts",
    "next.config.js",
    "app/**/*.{ts,tsx}",
    "scripts/**/*.{ts,cjs}",
    "tests/**/*.{ts,tsx}",
    ".storybook/**/*.{ts,tsx}",
    "stories/**/*.{ts,tsx}",
    "jest.config.cjs",
    "playwright.config.ts",
    "eslint.config.mjs"
  ],
  "project": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "constants/**/*.ts",
    "context/**/*.tsx",
    "hooks/**/*.ts",
    "lib/**/*.ts",
    "services/**/*.ts",
    "types/**/*.ts",
    "utils/**/*.ts"
  ],
  "ignore": [
    "babel-jest",
    "services/googleDocParser.ts#WorkoutTableData",
    "services/spotifyPlaylistService.ts#SpotifyPlaylistItem",
    "services/spotifyPlaylistService.ts#SpotifyPlaylist",
    "types/data-models.ts#WorkoutSession",
    "types/data-models.ts#HeartRateDataPoint",
    "types/genericTimer.ts#TimerPhase",
    "types/index.ts#HeartRateZonesProps",
    "types/index.ts#TimerDisplayProps",
    "types/index.ts#WorkoutColumnItem",
    "types/index.ts#WorkoutColumnsProps",
    "types/index.ts#WorkoutItem",
    "types/index.ts#WorkoutData"
  ],
  "ignoreBinaries": [
    "scripts/test-json-with-server.sh",
    "scripts/test-with-server.sh",
    "python3",
    "sleep"
  ]
}
