{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "server.ts",
    "proxy.ts",
    "next.config.js",
    "app/**/*.{ts,tsx}",
    "scripts/**/*.{ts,cjs}",
    "tests/**/*.{ts,tsx}",
    ".storybook/**/*.{ts,tsx}",
    "stories/**/*.{ts,tsx}",
    "jest.config.cjs",
    "playwright.config.ts",
