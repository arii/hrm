{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "server.ts",
    "app/**/*.tsx",
    "app/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "stories/**/*.tsx",
    "next.config.js",
    "jest.config.cjs",
    "playwright.config.ts"
  ],
  "ignore": [
    ".next/**",
    "dist/**",
    "coverage/**",
    "playwright-report/**",
    "**/*.log",
    "**/*.backup",
    "nohup.out",
    "diff.txt"
  ],
  "ignoreDependencies": [
    "@types/web-bluetooth",
    "jest-environment-jsdom"
  ],
  "ignoreBinaries": [
    "scripts/test-json-with-server.sh",
    "scripts/test-with-server.sh",
    "python3",
    "sleep"
  ]
}
